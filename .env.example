# Personal access token (classic), sin scopes, solo para subir el rate limit
# de la API de GitHub de 60 a 5000 req/hora. Generar en:
# GitHub -> Settings -> Developer settings -> Personal access tokens -> Tokens (classic)
GITHUB_TOKEN=

# URL pública del sitio (sin slash final). Se usa en sitemap.xml, robots.txt,
# metadataBase, canonical y el JSON-LD. Si se omite, cae a un placeholder
# definido en src/lib/profile.ts.
NEXT_PUBLIC_SITE_URL=https://michaelintriago.dev
